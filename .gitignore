node_modules/
dist/
.expo/

# ios/ is COMMITTED so Xcode Cloud can resolve a scheme — it configures a
# workflow against a scheme in a project that exists in the repo, and cannot
# select one from a directory that only materialises after clone. Roadmap
# deviation #28 records the cost: a native change now needs `npm run prebuild`
# *and* a commit of the result, or it silently does not ship.
#
# Only its build output stays out. Pods is 1.2 GB and CI reinstalls it from the
# committed Podfile.lock; .xcode.env.local holds a machine-specific absolute
# path to node and is regenerated by scripts/write-xcode-env.mjs.
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
ios/**/xcuserdata/

# android/ is still generated. Nothing builds it yet (V1.5), so it carries none
# of the reason above.
android/

*.log
.DS_Store

# Secrets — never commit
.env
.env.*
.venv-swap-assets
!.env.example
GoogleService-Info.plist
google-services.json
# Apple signing keys. The Sign in with Apple .p8 downloads exactly once and
# signs the client secret; keep it outside the repo entirely, but ignore the
# pattern too so a stray copy in the working tree cannot be committed.
*.p8

# Supabase CLI scratch
supabase/.temp/
supabase/.branches/

