# Copy to .env for local development.
#
# Both values are safe to ship inside the app binary — the publishable key is
# designed for client-side use and Row Level Security is what actually protects
# the data. They are kept out of git only so that swapping projects (staging vs
# production) never means editing tracked files.
#
# For EAS cloud builds these must also exist as EAS environment variables:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://<ref>.supabase.co"
#   eas env:create --name EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY --value "sb_publishable_..."
#
# The Supabase SECRET key belongs in neither file. Edge Functions receive it
# automatically as an injected environment variable.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
